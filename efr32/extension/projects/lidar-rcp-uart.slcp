# SPDX-License-Identifier: GPL-2.0-only
# ot-efr32's openthread-efr32-rcp-uart platform project for lidar: the
# application properties the Gecko bootloader sees in Amazon's images too,
# and no packet trace (its pins on this board are unknown).
# ot-efr32's CMake links the platform library by this project name.
project_name: openthread-efr32-rcp-uart
label: lidar ot-rcp
package: OpenThread
description: OpenThread RCP over UART for lidar's EFR32MG12
category: OpenThread Examples
quality: production
component:
  - id: ot_crash_handler
    from: ot-efr32
  - id: ot_platform_abstraction_core
  - id: ot_mbedtls
  - id: ot_stack_features_config
    from: ot-efr32
  - id: ot_core_vendor_extension
    from: ot-efr32
  - id: uartdrv_usart
    instance:
      - vcom
  - id: bootloader_interface
  - id: bootloader_app_properties
  - id: lidar_board
    from: lidar
define:
  - name: OPENTHREAD_COPROCESSOR
    value: 1
  - name: OPENTHREAD_RADIO
    value: 1
sdk_extension:
  - id: ot-efr32
    version: 0.0.1
  - id: lidar
    version: 0.0.1
