> !state
state {"language":"en","clock":false,"uptime":0,"ringing":[],"timers":[],"alarms":[],"last":null}
> what time is it
action time_get
result {"action":"time_get","arguments":{},"ok":false,"code":"no_clock","say":"I don't know the time yet."}
say en I don't know the time yet.
> set an alarm for seven
action alarm_set h12=1 hour=7 minute=0
result {"action":"alarm_set","arguments":{"h12":"1","hour":"7","minute":"0"},"ok":false,"code":"no_clock","say":"I don't know the time yet."}
say en I don't know the time yet.
> !clock 2026-11-22 18:00
> what time is it
action time_get
result {"action":"time_get","arguments":{},"ok":true,"code":"ok","say":"It's six PM."}
say en It's six PM.
> what's the date
action date_get
result {"action":"date_get","arguments":{},"ok":true,"code":"ok","say":"Today is Sunday November twenty-second."}
say en Today is Sunday November twenty-second.
> volume five
action volume_set level=5
run lidar-volume set 50
result {"action":"volume_set","arguments":{"level":"5"},"ok":true,"code":"ok","say":"Volume five."}
say en Volume five.
> what's the volume
action volume_get
result {"action":"volume_get","arguments":{},"ok":true,"code":"ok","say":"Volume five."}
say en Volume five.
> louder
action volume_change direction=up
run lidar-volume up
result {"action":"volume_change","arguments":{"direction":"up"},"ok":true,"code":"ok","say":"Louder."}
say en Louder.
> mute
action volume_mute mute=on
run lidar-volume mute
result {"action":"volume_mute","arguments":{"mute":"on"},"ok":true,"code":"ok","say":"Speaker muted."}
say en Speaker muted.
> unmute
action volume_mute mute=off
run lidar-volume unmute
result {"action":"volume_mute","arguments":{"mute":"off"},"ok":true,"code":"ok","say":"Speaker on."}
say en Speaker on.
> set a timer for ten minutes
action timer_set seconds=600
result {"action":"timer_set","arguments":{"seconds":"600"},"ok":true,"code":"ok","say":"Timer set for ten minutes."}
say en Timer set for ten minutes.
> pizza timer twelve minutes
action timer_set name=pizza seconds=720
result {"action":"timer_set","arguments":{"name":"pizza","seconds":"720"},"ok":true,"code":"ok","say":"Pizza timer set for twelve minutes."}
say en Pizza timer set for twelve minutes.
> how much time is left
action timer_list
result {"action":"timer_list","arguments":{},"ok":true,"code":"ok","say":"Timer ten minutes left. Pizza timer twelve minutes left."}
say en Timer ten minutes left. Pizza timer twelve minutes left.
> !advance 300
> how long is left on the pizza timer
action timer_list name=pizza
result {"action":"timer_list","arguments":{"name":"pizza"},"ok":true,"code":"ok","say":"Pizza timer seven minutes left."}
say en Pizza timer seven minutes left.
> cancel the egg timer
action timer_cancel name=egg
result {"action":"timer_cancel","arguments":{"name":"egg"},"ok":false,"code":"no_such_timer","say":"There is no such timer."}
say en There is no such timer.
> cancel the timer
action timer_cancel
result {"action":"timer_cancel","arguments":{},"ok":true,"code":"ok","say":"Timer cancelled."}
say en Timer cancelled.
> set a timer for one hour and five minutes
action timer_set seconds=3900
result {"action":"timer_set","arguments":{"seconds":"3900"},"ok":true,"code":"ok","say":"Timer set for one hour and five minutes."}
say en Timer set for one hour and five minutes.
