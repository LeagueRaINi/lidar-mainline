state {"language":"en","clock":true,"uptime":720,"ringing":[{"kind":"timer","name":"pizza"}],"timers":[{"name":"","seconds":3900,"ends":4200,"remaining":3480}],"alarms":[],"last":{"seq":16,"uptime":300,"text":"set a timer for one hour and five minutes","action":"timer_set","ok":true,"say":"Timer set for one hour and five minutes."}}
