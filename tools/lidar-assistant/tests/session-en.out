action timer_set seconds=90
result {"action":"timer_set","arguments":{"seconds":"90"},"ok":true,"code":"ok","say":"Timer set for one minute and thirty seconds."}
say en Timer set for one minute and thirty seconds.
> !advance 90
ring start
> !advance 700
ring stop
> set a timer for five minutes
action timer_set seconds=300
result {"action":"timer_set","arguments":{"seconds":"300"},"ok":true,"code":"ok","say":"Timer set for five minutes."}
say en Timer set for five minutes.
> set a timer for six minutes
