result {"action":"timer_list","arguments":{},"ok":false,"code":"no_timers","say":"No timers are running."}
say en No timers are running.
> set an alarm for seven
action alarm_set h12=1 hour=7 minute=0
result {"action":"alarm_set","arguments":{"h12":"1","hour":"7","minute":"0"},"ok":true,"code":"ok","say":"Alarm set for seven PM today."}
say en Alarm set for seven PM today.
> set an alarm for seven thirty tomorrow morning
action alarm_set day=tomorrow hour=7 minute=30
result {"action":"alarm_set","arguments":{"day":"tomorrow","hour":"7","minute":"30"},"ok":true,"code":"ok","say":"Alarm set for seven thirty AM tomorrow."}
say en Alarm set for seven thirty AM tomorrow.
> wake me at six on weekdays
action alarm_set h12=1 hour=6 minute=0 repeat=mon,tue,wed,thu,fri
result {"action":"alarm_set","arguments":{"h12":"1","hour":"6","minute":"0","repeat":"mon,tue,wed,thu,fri"},"ok":true,"code":"ok","say":"Alarm set for six AM on weekdays."}
say en Alarm set for six AM on weekdays.
> set an alarm for nine on weekends
action alarm_set h12=1 hour=9 minute=0 repeat=sat,sun
result {"action":"alarm_set","arguments":{"h12":"1","hour":"9","minute":"0","repeat":"sat,sun"},"ok":true,"code":"ok","say":"Alarm set for nine AM on weekends."}
say en Alarm set for nine AM on weekends.
> set an alarm every monday and wednesday at six am
action alarm_set hour=6 minute=0 repeat=mon,wed
result {"action":"alarm_set","arguments":{"hour":"6","minute":"0","repeat":"mon,wed"},"ok":true,"code":"ok","say":"Alarm set for six AM every Monday and Wednesday."}
say en Alarm set for six AM every Monday and Wednesday.
> set an alarm for seven
action alarm_set h12=1 hour=7 minute=0
result {"action":"alarm_set","arguments":{"h12":"1","hour":"7","minute":"0"},"ok":true,"code":"ok","say":"Alarm set for seven PM today."}
say en Alarm set for seven PM today.
> what alarms do i have
action alarm_list
result {"action":"alarm_list","arguments":{},"ok":true,"code":"ok","say":"Alarm at seven PM today. Alarm at six AM on weekdays. Alarm at six AM every Monday and Wednesday. Alarm at seven thirty AM tomorrow. Alarm at nine AM on weekends."}
